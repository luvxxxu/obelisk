# Public URL of the web app (what you type in the browser and give to Claude/ChatGPT).
PUBLIC_URL=https://obelisk.example.com

# Database password — letters and digits only (it is embedded in a URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# The starting sign-up mode. The first account to sign up becomes the server's operator, and operators
# change the mode later in 서버 관리 (/admin) without a redeploy (that choice then wins over this value).
# first    = only invite links after the first account (personal server, default)
# open     = anyone with the URL can sign up
# approval = anyone can apply; an operator approves each new account
# invite   = only with an invite link (organization invite or 서버 관리 → 가입 → 초대 링크)
# closed   = same as invite (kept for older setups)
SIGNUP_MODE=first

# Days of daily pg_dump backups to keep in the obelisk-backups volume.
BACKUP_KEEP_DAYS=14

# Optional. Seals users' own third-party API keys (Jev / TypeSafe) in the database.
# Unset = derived from the database password. Changing it later means users re-enter their keys.
# SECRET_KEY=

# Optional. Mail for "비밀번호 찾기" (password reset links), sent through your own mailbox's SMTP server:
#   Gmail:  smtps://you@gmail.com:<app password>@smtp.gmail.com:465
#   Naver:  smtps://you@naver.com:<app password>@smtp.naver.com:465
#   Cloudflare Email Service (your own domain, Workers Paid):
#           smtps://api_token:<API token with Email Sending: Edit>@smtp.mx.cloudflare.net:465
#           with MAIL_FROM=Obelisk <no-reply@your-domain>
# URL-encode @ : / ? # inside the password. Unset = the reset link is hidden.
# MAIL_FROM defaults to the SMTP login address, which is what a mailbox SMTP requires.
# SMTP_URL=
# MAIL_FROM=

# Optional. true = log a one-time "become operator" link at start even though operators exist
# (every operator lost access). Turn it back off after using the link.
# ADMIN_CLAIM=false

# Optional. What 서버 관리 → 업데이트 확인 compares this build with (a fork can point at itself).
# UPDATE_REPO=luvxxxu/obelisk
# UPDATE_BRANCH=main
