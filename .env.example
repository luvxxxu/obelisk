# Public URL of the web app (what you type in the browser and give to Claude/ChatGPT).
PUBLIC_URL=https://obelisk.example.com

# Database password — letters and digits only (it is embedded in a URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# first  = only the first account can sign up (personal server, default)
# open   = anyone with the URL can sign up
# closed = nobody can sign up
SIGNUP_MODE=first

# Days of daily pg_dump backups to keep in the obelisk-backups volume.
BACKUP_KEEP_DAYS=14
